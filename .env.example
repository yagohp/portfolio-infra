# ─────────────────────────────────────────────────────────────────
# Jenkins base
# ─────────────────────────────────────────────────────────────────
JENKINS_URL=
JENKINS_ADMIN_PASSWORD=
JENKINS_API_TOKEN=
JENKINS_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────────────────────────
# Private Key
GITHUB_SSH_KEY=""
GITHUB_ORG=


# ─────────────────────────────────────────────────────────────────
# POSTGRESQL DATABASE (Shared)
# ─────────────────────────────────────────────────────────────────
# Credentials used by POstgreSQL container and NPM (Nginx Proxy Manager)
DB_POSTGRES_HOST=
DB_POSTGRES_PORT=
DB_POSTGRES_USER=
DB_POSTGRES_PASSWORD=
DB_POSTGRES_NAME=

# ─────────────────────────────────────────────────────────────────
# MINISTACK (AWS Emulator)
# ─────────────────────────────────────────────────────────────────
# IP of where MiniStack is running
MINISTACK_ENDPOINT=
# Credentials "dummy" required by AWS CLI and Terraform for MiniStack
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=